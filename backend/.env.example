APP_NAME=SisaCare.AI API
APP_ENV=development
# Set true only after building frontend/dist for a single-origin deployment.
SERVE_FRONTEND=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Relative paths are resolved from the repository root.
YOLO_MODEL_PATH=ai/models/expV2.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

# Isolated local Florence-2 service used by the active photo analysis endpoint.
FLORENCE_SERVICE_URL=http://127.0.0.1:8765
FLORENCE_SERVICE_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://localhost:11434
# Separate local image-capable fallback for generic/unmapped Florence labels.
# Install first with: ollama pull qwen2.5vl:3b (about 3.2 GB; allow GPU/RAM headroom).
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# The existing text-only report generator uses this model.
OLLAMA_REPORT_MODEL=llama3.2
# Vision can require a longer cold start than text report generation.
OLLAMA_VISION_TIMEOUT_SECONDS=120
OLLAMA_REPORT_TIMEOUT_SECONDS=60
# Keep loaded Ollama models available between normal development requests.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_ALLOW_REMOTE=false
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=43200
# Set true behind HTTPS in production; false only for local HTTP development.
SESSION_COOKIE_SECURE=false

# Citizen status events remain queued when USER_SMTP_HOST is blank.
# Admin submission alerts are created only when the admin channel is configured.
# Mailtrap Sandbox captures admin messages without delivering them to a real inbox.
ADMIN_NOTIFICATION_EMAIL=admin@example.com
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_USERNAME=
ADMIN_SMTP_PASSWORD=
ADMIN_SMTP_FROM=notifications@example.com
ADMIN_SMTP_SECURITY=starttls
NOTIFY_ADMIN_ON_STATUS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Use a delivery-capable SMTP provider for community users. Google sign-in
# does not provide SMTP access; Gmail users can receive mail from any sender.
USER_SMTP_HOST=
USER_SMTP_PORT=587
USER_SMTP_USERNAME=
USER_SMTP_PASSWORD=
USER_SMTP_FROM=notifications@example.com
USER_SMTP_SECURITY=starttls
EMAIL_PUBLIC_BASE_URL=http://localhost:5173
# Optional citizen updates. Verified resolution email is always queued when a
# verified recipient snapshot exists; these switches affect earlier stages.
NOTIFY_CITIZEN_ON_ASSIGNMENT=false
NOTIFY_CITIZEN_ON_PROGRESS=false

# Upload size is measured in bytes (10 MiB by default).
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=40000000
UPLOAD_DIR=backend/storage/tmp/uploads
ANNOTATED_OUTPUT_DIR=backend/storage/tmp/annotated
DATABASE_PATH=backend/storage/sisacare.db
REPORT_ASSETS_DIR=backend/storage/reports
# Set postgres only after applying migrations and importing a verified backup.
PERSISTENCE_BACKEND=sqlite
# Server only. Use the Supabase direct or session-pooler connection string with TLS.
POSTGRES_DATABASE_URL=
# Optional separate SQLite forecast database for an isolated synthetic demo.
# Leave unset for production forecasts in the configured report database.
HOTSPOT_FORECAST_DATABASE_PATH=
# No municipal service area is assumed. Configure jurisdiction routing only after authorization.

# Use the same Supabase project configured by the frontend. The publishable key
# is intended for client-side use; never place a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Required for the Google existing-account precheck.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=

# Explicit origins only. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=60
