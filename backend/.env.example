APP_NAME=SisaCare.AI API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Relative paths are resolved from the repository root.
YOLO_MODEL_PATH=ai/models/expV2.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

OLLAMA_BASE_URL=http://localhost:11434
# Name of an installed Ollama vision-capable model used for image understanding.
OLLAMA_VISION_MODEL=
# The existing text-only report generator uses this model.
OLLAMA_REPORT_MODEL=llama3.2
# Vision can require a longer cold start than text report generation.
OLLAMA_VISION_TIMEOUT_SECONDS=120
OLLAMA_REPORT_TIMEOUT_SECONDS=60
# Keep loaded Ollama models available between normal development requests.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_ALLOW_REMOTE=false

# Upload size is measured in bytes (10 MiB by default).
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=40000000
UPLOAD_DIR=backend/storage/tmp/uploads
ANNOTATED_OUTPUT_DIR=backend/storage/tmp/annotated
DATABASE_PATH=backend/storage/sisacare.db
REPORT_ASSETS_DIR=backend/storage/reports

# Use the same Supabase project configured by the frontend. The publishable key
# is intended for client-side use; never place a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Explicit origins only. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=60

# TomTom Search and Reverse Geocoding are called only by the backend.
# Restrict this key to the required TomTom APIs in the TomTom dashboard.
TOMTOM_API_KEY=your-tomtom-api-key
TOMTOM_TIMEOUT_SECONDS=8
TOMTOM_COUNTRY_SET=MY
LOCATION_RATE_LIMIT_REQUESTS=30
LOCATION_RATE_LIMIT_WINDOW_SECONDS=60
