# Use frontend/.env.example and backend/.env.example for each service.

# Supabase Auth SMTP. Copy this file to .env and set the real Mailtrap values
# before running `npx.cmd supabase start` or pushing auth config.
MAILTRAP_SMTP_USER=your-mailtrap-smtp-user
MAILTRAP_SMTP_PASS=your-mailtrap-smtp-password
MAILTRAP_FROM_EMAIL=from@example.com
